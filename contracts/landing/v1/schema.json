{
  "contract": "landing",
  "version": "v1",
  "tables": {
    "walk": {
      "grain": "one run report: one area walked by one run",
      "columns": [
        {"name": "source", "type": "VARCHAR"},
        {"name": "area", "type": "VARCHAR"},
        {"name": "run_started_at", "type": "TIMESTAMP WITH TIME ZONE"},
        {"name": "run_ended_at", "type": "TIMESTAMP WITH TIME ZONE"},
        {"name": "observed_date", "type": "DATE"},
        {"name": "complete", "type": "BOOLEAN"},
        {"name": "is_replay", "type": "BOOLEAN"},
        {"name": "is_replay_source", "type": "VARCHAR"},
        {"name": "pages", "type": "INTEGER"},
        {"name": "result_count", "type": "INTEGER"},
        {"name": "duration_seconds", "type": "DOUBLE"}
      ]
    },
    "observation": {
      "grain": "one search-card row as Bronze holds it; not deduplicated",
      "columns": [
        {"name": "source", "type": "VARCHAR"},
        {"name": "area", "type": "VARCHAR"},
        {"name": "operation", "type": "VARCHAR"},
        {"name": "municipality", "type": "VARCHAR"},
        {"name": "district", "type": "VARCHAR"},
        {"name": "source_listing_id", "type": "VARCHAR"},
        {"name": "observed_at", "type": "TIMESTAMP WITH TIME ZONE"},
        {"name": "observed_date", "type": "DATE"},
        {"name": "ingested_at", "type": "TIMESTAMP WITH TIME ZONE"},
        {"name": "price_eur", "type": "INTEGER"},
        {"name": "prev_price_eur", "type": "INTEGER"},
        {"name": "price_drop_pct", "type": "DOUBLE"},
        {"name": "sqm_built", "type": "INTEGER"},
        {"name": "rooms", "type": "INTEGER"},
        {"name": "freshness_label", "type": "VARCHAR"},
        {"name": "property_type", "type": "VARCHAR"},
        {"name": "is_empty_card", "type": "BOOLEAN"}
      ]
    },
    "listing_detail": {
      "grain": "one detail record as Bronze holds it; not deduplicated",
      "columns": [
        {"name": "source", "type": "VARCHAR"},
        {"name": "area", "type": "VARCHAR"},
        {"name": "operation", "type": "VARCHAR"},
        {"name": "municipality", "type": "VARCHAR"},
        {"name": "district", "type": "VARCHAR"},
        {"name": "source_listing_id", "type": "VARCHAR"},
        {"name": "observed_at", "type": "TIMESTAMP WITH TIME ZONE"},
        {"name": "observed_date", "type": "DATE"},
        {"name": "extraction_version", "type": "VARCHAR"},
        {"name": "property_type", "type": "VARCHAR"},
        {"name": "price_eur", "type": "INTEGER"},
        {"name": "prev_price_eur", "type": "INTEGER"},
        {"name": "price_drop_pct", "type": "DOUBLE"},
        {"name": "community_fee_eur_month", "type": "INTEGER"},
        {"name": "sqm_built", "type": "INTEGER"},
        {"name": "sqm_usable", "type": "INTEGER"},
        {"name": "sqm_plot", "type": "INTEGER"},
        {"name": "rooms", "type": "INTEGER"},
        {"name": "bathrooms", "type": "INTEGER"},
        {"name": "floor", "type": "VARCHAR"},
        {"name": "storeys", "type": "INTEGER"},
        {"name": "is_exterior", "type": "BOOLEAN"},
        {"name": "orientation", "type": "VARCHAR[]"},
        {"name": "has_elevator_state", "type": "VARCHAR"},
        {"name": "has_balcony_state", "type": "VARCHAR"},
        {"name": "has_terrace_state", "type": "VARCHAR"},
        {"name": "has_pool_state", "type": "VARCHAR"},
        {"name": "has_garden_state", "type": "VARCHAR"},
        {"name": "has_storage_room_state", "type": "VARCHAR"},
        {"name": "has_parking", "type": "BOOLEAN"},
        {"name": "parking_included_in_price", "type": "BOOLEAN"},
        {"name": "has_ac_state", "type": "VARCHAR"},
        {"name": "has_fitted_wardrobes_state", "type": "VARCHAR"},
        {"name": "has_heating", "type": "BOOLEAN"},
        {"name": "heating_scope", "type": "VARCHAR"},
        {"name": "heating_type", "type": "VARCHAR"},
        {"name": "neighborhood", "type": "VARCHAR"},
        {"name": "page_district", "type": "VARCHAR"},
        {"name": "city", "type": "VARCHAR"},
        {"name": "latitude", "type": "DOUBLE"},
        {"name": "longitude", "type": "DOUBLE"},
        {"name": "year_built", "type": "INTEGER"},
        {"name": "condition", "type": "VARCHAR"},
        {"name": "energy_consumption_rating", "type": "VARCHAR"},
        {"name": "energy_consumption_kwh_m2", "type": "INTEGER"},
        {"name": "energy_emissions_rating", "type": "VARCHAR"},
        {"name": "energy_emissions_kg_m2", "type": "INTEGER"},
        {"name": "is_occupied", "type": "BOOLEAN"},
        {"name": "missing_fields", "type": "VARCHAR[]"},
        {"name": "ingested_at", "type": "TIMESTAMP WITH TIME ZONE"}
      ]
    },
    "listing_text": {
      "grain": "one detail record's free text, verbatim; joins listing_detail on (area, source_listing_id, observed_at)",
      "columns": [
        {"name": "source", "type": "VARCHAR"},
        {"name": "area", "type": "VARCHAR"},
        {"name": "source_listing_id", "type": "VARCHAR"},
        {"name": "observed_at", "type": "TIMESTAMP WITH TIME ZONE"},
        {"name": "observed_date", "type": "DATE"},
        {"name": "ingested_at", "type": "TIMESTAMP WITH TIME ZONE"},
        {"name": "title", "type": "VARCHAR"},
        {"name": "location", "type": "VARCHAR"},
        {"name": "description", "type": "VARCHAR"},
        {"name": "features", "type": "VARCHAR[]"}
      ]
    }
  }
}
